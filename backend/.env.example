# ===============================================
# DocuMind AI Configuration
# Copy this file to ".env" and fill in your keys.
# NEVER commit your real .env file to Git.
# ===============================================

# Primary LLM: Anthropic Claude (Get your key at console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional fallback LLM: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=false

# Document & RAG Configuration
MAX_UPLOAD_SIZE_BYTES=15728640    # 15 MB
MAX_DOCUMENT_CHARS=500000        # Max document characters (~100k words)
DIRECT_PROCESSING_CHAR_LIMIT=12000 # Documents larger than this trigger Vector RAG
CHUNK_SIZE=1000                  # Character size per chunk
CHUNK_OVERLAP=150                # Character overlap between chunks
TOP_K_CHUNKS=5                   # Top chunks retrieved per query

# Development / Offline Test Mock (set true to test without spending API credits)
ENABLE_MOCK_FALLBACK=false
